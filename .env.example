# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MAX_UPLOAD_SIZE_MB: Maximum upload size in megabytes for server-side PDF routes.
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB="50"

# NEXT_PUBLIC_GA_MEASUREMENT_ID: Google Analytics 4 Measurement ID for PDFNestly.com.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-MSPZRXHB28"

# SESSION_SECRET: Server-only HMAC-SHA256 secret used to sign HttpOnly session cookies.
SESSION_SECRET="REPLACE_WITH_32_BYTE_RANDOM_HEX_SECRET"

# INITIAL_ADMIN_EMAIL: Bootstrap administrator email address granted admin privileges on signup/login.
INITIAL_ADMIN_EMAIL="rfjatt002@gmail.com"

# Transactional Email Delivery (Server-only — configure one provider to send password reset emails):
EMAIL_FROM="PDFNestly Security <no-reply@pdfnestly.com>"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
POSTMARK_SERVER_TOKEN=""
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_SECRET=""

