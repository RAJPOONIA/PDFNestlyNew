# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MAX_UPLOAD_SIZE_MB: Maximum upload size in megabytes for server-side PDF routes.
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB="50"

# NEXT_PUBLIC_GA_MEASUREMENT_ID: Google Analytics 4 Measurement ID for PDFNestly.com.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-MSPZRXHB28"

# SESSION_SECRET: Server-only HMAC-SHA256 secret used to sign HttpOnly session cookies.
SESSION_SECRET="REPLACE_WITH_32_BYTE_RANDOM_HEX_SECRET"

# INITIAL_ADMIN_EMAIL: Bootstrap administrator email address granted admin privileges on signup/login.
INITIAL_ADMIN_EMAIL="rfjatt002@gmail.com"

# Transactional Email Delivery (Server-only — never prefix with NEXT_PUBLIC_):
# Namecheap Private Email SMTP (Primary production provider for https://pdfnestly.com):
EMAIL_PROVIDER=""
PRIVATE_EMAIL_SMTP_HOST=""
# Optional SMTP connection IP override if VPS DNS resolution for PRIVATE_EMAIL_SMTP_HOST times out.
# TLS SNI (servername) and certificate verification still validate against PRIVATE_EMAIL_SMTP_HOST.
# Note: Do not assume an SMTP IP is permanent; update or remove this override if the email provider changes its SMTP IP.
PRIVATE_EMAIL_SMTP_IP=""
PRIVATE_EMAIL_SMTP_PORT=""
PRIVATE_EMAIL_SMTP_USER=""
PRIVATE_EMAIL_SMTP_PASSWORD=""
PRIVATE_EMAIL_FROM=""

# Optional alternative transactional email providers:
EMAIL_FROM="PDFNestly Support <support@pdfnestly.com>"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
POSTMARK_SERVER_TOKEN=""
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_SECRET=""

# Optional Server-Side Analytics & Billing Integrations (never prefix secrets with NEXT_PUBLIC_):
GA4_PROPERTY_ID=""
GA4_SERVICE_ACCOUNT_KEY=""
GSC_SITE_URL="https://pdfnestly.com"
GSC_SERVICE_ACCOUNT_KEY=""
ADSENSE_ACCOUNT_ID=""
ADSENSE_OAUTH_TOKEN=""
STRIPE_SECRET_KEY=""

# Optional Native PDF Engine Binary Overrides (auto-resolved via /usr/bin/qpdf and /usr/bin/gs by default):
QPDF_BIN_PATH=""
GS_BIN_PATH=""
