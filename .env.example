# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MAX_UPLOAD_SIZE_MB: Maximum upload size in megabytes for server-side PDF routes.
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB="50"

# NEXT_PUBLIC_GA_MEASUREMENT_ID: Google Analytics 4 Measurement ID for PDFNestly.com.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-MSPZRXHB28"


